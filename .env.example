# Configuração do Banco de Dados PostgreSQL (Neon Cloud ou Local)
# Exemplo Neon: postgresql://seu_usuario:sua_senha@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./radar_julius.db

# Configurações de Notificações WhatsApp Diretas (sem n8n)
# Provedor padrão: callmebot (100% gratuito para alertas pessoais) ou evolution / zapi
WHATSAPP_PROVIDER=callmebot
WHATSAPP_PHONE=5551999999999
WHATSAPP_APIKEY=seu_codigo_apikey_aqui
# Caso use Evolution API ou instância própria:
WHATSAPP_API_URL=https://sua-instancia.com/message/sendText

# Configurações de Monitoramento Contínuo
CHECK_INTERVAL_MINUTES=60
DEFAULT_DROP_PERCENTAGE=10.0
DEFAULT_USER_CEP=93010000
